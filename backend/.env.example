# Copy this file to .env and fill in your values

# Server
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# Gemini API - get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback (Groq - https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional local fallback (Ollama running locally, e.g. `ollama run llama3`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
